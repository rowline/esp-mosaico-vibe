# Loaded after Muse's sdkconfig.defaults and devices/sdkconfig.esp-mosaico.

# ESP-Mosaico application contract (esp-mosaico-utils hello_world template).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FACTORY_RECOVERY_BOOT_GPIO=7
CONFIG_FACTORY_RECOVERY_BOOT_DEBOUNCE_MS=50
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_IRIS_TRANSPORT_USB=y
# ESP-Iris over USB only. With the template's TCP transport also on, the board
# stopped answering ESP-Iris on USB once Muse had joined Wi-Fi (2026-10-04);
# nothing here uses ESP-Iris over Wi-Fi.
# CONFIG_ESP_IRIS_TRANSPORT_TCP is not set
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TRANSPORT_CLAIM_TIMEOUT_MS=2000
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
CONFIG_ESP_IRIS_USB_TASK_STACK_SIZE=2048
CONFIG_ESP_IRIS_SERVICE_STACK_SIZE=4096
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_IRIS_SERVICE_CONTEXT_PSRAM=y
CONFIG_ESP_IRIS_SERVICE_STATE_PSRAM=y
CONFIG_ESP_IRIS_RPC_RESPONSE_PSRAM=y
CONFIG_ESP_IRIS_WIRE_BUFFERS_PSRAM=y
# The largest ring: boot logs outlast a smaller one before the host reconnects,
# and it keeps more context in Core Dumps (2026-10-05, chasing crashes).
CONFIG_ESP_IRIS_LOG_RING_BYTES=16384
CONFIG_ESP_IRIS_LOG_RING_STORAGE_PSRAM=y
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico muse_gadget"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Muse's on-screen UI (devices/sdkconfig.muse) with the board in
# components/mosaico_board. That board drives LVGL itself, through Muse's
# esp_lvgl_adapter, so the BSP's own LVGL layer stays off.
CONFIG_MUSE_BOARD_HOST=y
CONFIG_BSP_DISPLAY_LVGL_ENABLE=n
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# The board's wide font for Chinese captions is an LVGL binary font in the
# image, loaded through LVGL's memory file system ('M').
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77

# Camera module in the left slot (components/mosaico_camera), serving Muse's
# camera.capture. Its sensor, OV3640 or SC101IOT, gives YUV422 at its default
# size (1024 x 768 or 1280 x 720) and the capture encodes the JPEG; the
# SC101IOT has no JPEG mode.
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_1024X768_25FPS=y
# The camera's D2 and flash LED sit on the USB Serial/JTAG pads (GPIO33/34),
# so USB Serial/JTAG stays off, as in the BSP's camera examples, and Muse's
# serial tools use the console UART.
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
CONFIG_MUSE_CONSOLE_UART=y

# Interaction module in either slot (components/mosaico_presence): someone
# walking up lights its LEDs, wakes the screen and gets greeted by name.
CONFIG_MOSAICO_PRESENCE_NAME="Rollin"

# Code and constants run from flash, not from a PSRAM copy (the template's
# XIP from PSRAM). With the copy, loads from valid PSRAM data within 47 KB past
# the PMP boundary where the copied .rodata (read-only) meets data (read-write)
# faulted now and then: five crashes on 2026-10-04/05, one every few minutes
# under load. Without it, 25 minutes of the same load and real replies ran
# clean (STATE.md). Memory protection stays on. ESP-Iris's PSRAM placements
# above depend on XIP and are dropped; internal RAM free stays about 64 KB.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set

# Muse on Vibe Mode: Vibe Mode writes and accepts images, so Muse's own OTA
# and its 5-minute rollback guard stay off.
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_HOMEHUB_OTA_ROLLBACK_GUARD=n
# Images are not signed: the retained bootloader doesn't check signatures and
# Muse's signing key path is relative to the SDK, not this project.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=n
# phy_init lies in the retained prefix; keep PHY data in the app so Muse never
# writes default calibration data into it.
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
